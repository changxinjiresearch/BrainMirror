# Replace with your Oracle free VM public IPv4 and free sslip.io hostname:
# Example: 192-0-2-10.sslip.io (TEST-NET-1; NOT A REAL DEPLOYMENT)
SCEPT_HOST=REPLACE-ME.sslip.io

# Site origin already deployed; leave unchanged unless you use another Vercel domain
SCEPT_WEB_ORIGIN=https://brainmirror-observatory.vercel.app

# Generate a long private random token locally; never put the value in GitHub.
SCEPT_RUN_TOKEN=REPLACE_WITH_RANDOM_64_CHAR_SECRET
